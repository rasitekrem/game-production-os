{
  "description": "A project trigger cannot be routed without Human Review.",
  "schema": "task-routing",
  "base": "examples/example-task-routing.json",
  "set": {
    "/workflow": "visual-review",
    "/primary_specialist": "camera-composition",
    "/secondary_specialists": [],
    "/reviewers": [
      "HUMAN"
    ],
    "/review_triggers": [
      "PROJECT:boss-fight-feel"
    ],
    "/required_gates": [
      {
        "gate": "CAMERA_COMPOSITION",
        "owner": "camera-composition",
        "blocking": true,
        "review_policy": "HUMAN_REVIEW_REQUIRED",
        "cross_review_required": false,
        "applied_conditions": [
          "CAMERA_MOTION_CLAIM",
          "TARGET_PRESENTATION_DIFFERS"
        ],
        "required_evidence": [
          "VISUAL_EVIDENCE",
          "MOTION_EVIDENCE"
        ]
      },
      {
        "gate": "HUMAN_REVIEW",
        "owner": "HUMAN",
        "blocking": true,
        "review_policy": "HUMAN_REVIEW_REQUIRED",
        "required_evidence": [
          "HUMAN_EVIDENCE"
        ]
      }
    ],
    "/human_review": {
      "required": false,
      "not_required_reason": "x"
    },
    "/omitted_gates": []
  },
  "remove": [],
  "expect": "invalid",
  "expect_keyword": "const"
}
