          "MOTION_EVIDENCE"
        ]
      },
      {
        "gate": "HUMAN_REVIEW",
        "owner": "HUMAN",
        "blocking": true,
        "review_policy": "HUMAN_REVIEW_REQUIRED",
        "required_evidence": [
          "HUMAN_EVIDENCE"
        ]
      }
